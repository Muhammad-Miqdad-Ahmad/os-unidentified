   119                                  print_string:   								; sub routiene aka function in assembly
   120 00000175 50                      	push    ax									; Save AX OH I LOVE THE STACK
   121 00000176 B40E                    	mov     ah, 0Eh
   122                                  .loop_start:
   123 00000178 8A04                    	mov     al, [si]							; load the data at the memory address stored in DS+SI,
   124 0000017A 3C00                    	cmp     al, 0x00							; compare if al is 0 (string terminator)
   125 0000017C 7405                    	je      .loop_end							; if yes then go to loop end if not then continue
   126                                  
   127 0000017E CD10                    	int     10h									; execute the interrupt
   128 00000180 46                      	inc     si									; increment thevalue of si,
   129 00000181 EBF5                    	jmp     .loop_start							; Jump back to '.loop_start' regardless
   130                                  .loop_end:
   131 00000183 58                      	pop     ax
   132 00000184 C3                      	ret     									; return to the caller
