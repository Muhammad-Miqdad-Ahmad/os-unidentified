   108                                  dap:
   109 00000165 10                      	db      16									; size
   110 00000166 00                      	db      0
   111 00000167 0100                    	dw      1									; read 1 sector
   112                                  
   113 00000169 0080                    	dw      0x8000								; offset
   114 0000016B 0000                    	dw      0x0000								; segment
   115                                  
