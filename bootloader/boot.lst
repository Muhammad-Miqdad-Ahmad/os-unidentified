    90                                  read_failed:
    91 00000082 BE[4601]                	mov     si, failure_reading
    92 00000085 E8ED00                  	call    print_string
    93                                  
    94                                  hang:
    95 00000088 F4                      	hlt     									; halt the CPU until the next interrupt
    96 00000089 EBFD                    	jmp     hang								; jump back to hang, creating an infinite loop
    97                                  
    98 0000008B 0D0A00                  newline         db      0x0D, 0x0A, 0
    99 0000008E 00                      boot_drive      db      0						; storage for boot drive number (also doubles as string bytes here)
   100 0000008F 4346203D20302E2054-     cfIs0           db      "CF = 0. The AH=41h check succeeded. Continue checking BX and CX.", 0
   100 00000098 68652041483D343168-
   100 000000A1 20636865636B207375-
   100 000000AA 636365656465642E20-
   100 000000B3 436F6E74696E756520-
   100 000000BC 636865636B696E6720-
   100 000000C5 425820616E64204358-
   100 000000CE 2E00               
   101 000000D0 42782076616C756520-     bxdidswap       db      "Bx value is aa55, 42h is supported", 0
   101 000000D9 697320616135352C20-
   101 000000E2 343268206973207375-
   101 000000EB 70706F7274656400   
   102 000000F3 435820307468206269-     cxsetbit        db      "CX 0th bit is 1, 42h is supported", 0
   102 000000FC 7420697320312C2034-
   102 00000105 326820697320737570-
   102 0000010E 706F7274656400     
   103 00000115 456464206973206E6F-     edd_unsupported db      "Edd is not supported. Exiting the Bootloader", 0
   103 0000011E 7420737570706F7274-
   103 00000127 65642E204578697469-
   103 00000130 6E672074686520426F-
   103 00000139 6F746C6F6164657200 
   104 00000142 0000                    saved_bx        dw      0
   105 00000144 0000                    saved_cx        dw      0
