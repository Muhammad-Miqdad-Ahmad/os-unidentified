     1                                  ; nasm  main.asm -f bin -o boot.img
     2                                  ; nasm -f bin -l boot.lst main.asm -o boot.img
     3                                  
     4                                  	[org    0x7c00]								; will start the code at this memory location.
     5                                  ; This is the location where the BIOS expects to find a bootloader.
     6                                  ; The first thing I will do is to save the value in the dl register. it is actually the
     7                                  ; boot drive number.
     8                                  
     9                                  
    10                                  
    11 00000000 31C0                    	xor     ax, ax								; Making the ax register 0
    12 00000002 8ED8                    	mov     ds, ax								; set data segment to 0 usi,ng zeroed ax
    13 00000004 8EC0                    	mov     es, ax								; set extra segment to 0 usi,ng zeroed ax
    14 00000006 8ED0                    	mov     ss, ax								; set stack segment to 0 usi,ng zeroed ax
    15 00000008 BC007C                  	mov     sp, 0x7C00							; set stack pointer to 0x7C00 (grows downward from here)
    16                                  
    17 0000000B 8816[8E00]              	mov     [boot_drive], dl					; store BIOS-provided drive number into boot_drive variable
    18                                  
    19                                  	; mov     ah, 0Eh								; sooooooooooooo 0x0E is 14 I can load 14 instead of 0x0E
    20 0000000F B700                    	mov     bh, 0								; set page number to 0 for the teletype output function
    21                                  
    22 00000011 B441                    	mov     ah, 0x41							; 41h is the function to check the EDD
    23 00000013 BBAA55                  	mov     bx, 0x55aa							; Checking if the bios supports the AH = 42h. EDD installation check
    24 00000016 8A16[8E00]              	mov     dl, [boot_drive]
    25 0000001A CD13                    	int     13h									; calling the 13h function
    26 0000001C 891E[4201]              	mov     [saved_bx], bx
    27 00000020 890E[4401]              	mov     [saved_cx], cx
    28                                  	; Theoritaclly speaking it should set CF = 1
    29                                  	; I cant check cf like normal register. it is a flag and not a register.
    30 00000024 724E                    	jc      edd_not_supported					; cf is not zero so it jumps
    31                                  
    32                                  ; cf is 0:
    33                                  
    34                                  ;checking the bx register
    35 00000026 813E[4201]55AA          	cmp     word [saved_bx], 0xaa55
    36 0000002C 7546                    	jne     edd_not_supported
    37                                  
    38                                  ; bx worked the strings were equal
    39 0000002E F706[4401]0100          	test    word [saved_cx], 1					; the zeroeth bit or the rightmost bit should be 1
    40                                  	; TEST performs a bitwise AND without changing CX.
    41                                  	; It only updates the FLAGS register.
    42 00000034 7502                    	jnz     cx_worked							; jump if not zero
    43 00000036 EB3C                    	jmp     edd_not_supported
    44                                  
    45                                  cx_worked:
    46                                  
    47 00000038 56                      	push    si
    48 00000039 BE[8F00]                	mov     si, cfIs0
    49 0000003C E83601                  	call    print_string
    50 0000003F BE[8B00]                	mov     si, newline
    51 00000042 E83001                  	call    print_string
    52 00000045 5E                      	pop     si
    53                                  
    54 00000046 56                      	push    si
    55 00000047 BE[D000]                	mov     si, bxdidswap
    56 0000004A E82801                  	call    print_string
    57 0000004D BE[8B00]                	mov     si, newline
    58 00000050 E82201                  	call    print_string
    59 00000053 5E                      	pop     si
    60                                  
    61 00000054 56                      	push    si
    62 00000055 BE[F300]                	mov     si, cxsetbit
    63 00000058 E81A01                  	call    print_string
    64 0000005B BE[8B00]                	mov     si, newline
    65 0000005E E81401                  	call    print_string
    66 00000061 5E                      	pop     si
    67                                  
    68                                  	; Now lets load the second sector into the memory by using the 42h
    69 00000062 B442                    	mov     ah, 42h
    70 00000064 8A16[8E00]              	mov     dl, [boot_drive]
    71                                  
    72 00000068 BE[6501]                	mov     si, dap								; SI = offset of DAP
    73                                  ; DS is already 0
    74                                  
    75                                  
    76 0000006B CD13                    	int     13h
    77 0000006D 7213                    	jc      read_failed
    78                                  
    79 0000006F EA00800000              	jmp     0x0000:0x8000
    80                                  
    81                                  
    82                                  edd_not_supported:
    83 00000074 56                      	push    si
    84 00000075 BE[1501]                	mov     si, edd_unsupported
    85 00000078 E8FA00                  	call    print_string
    86 0000007B BE[8B00]                	mov     si, newline
    87 0000007E E8F400                  	call    print_string
    88 00000081 5E                      	pop     si
